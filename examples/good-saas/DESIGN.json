{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "background": { "$value": "oklch(98% 0.01 95)", "$type": "color" },
    "foreground": { "$value": "oklch(22% 0.02 250)", "$type": "color" },
    "muted": { "$value": "oklch(45% 0.015 250)", "$type": "color" },
    "accent": { "$value": "oklch(38% 0.10 155)", "$type": "color" },
    "border": { "$value": "oklch(88% 0.01 95)", "$type": "color" }
  },
  "typography": {
    "fontFamily": {
      "display": { "$value": "Source Serif 4, Georgia, serif", "$type": "fontFamily" },
      "body": { "$value": "Inter, system-ui, sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "JetBrains Mono, ui-monospace, monospace", "$type": "fontFamily" }
    },
    "scale": {
      "ratio": { "$value": 1.25, "$type": "number" },
      "base": { "$value": "16px", "$type": "dimension" }
    }
  },
  "spacing": {
    "unit": { "$value": "8px", "$type": "dimension" },
    "scale": { "$value": "4 8 12 16 24 32 48 64 96", "$type": "string" }
  },
  "motion": {
    "easing": { "$value": "cubic-bezier(0.16, 1, 0.3, 1)", "$type": "cubicBezier" },
    "duration": {
      "fast": { "$value": "120ms", "$type": "duration" },
      "base": { "$value": "220ms", "$type": "duration" },
      "slow": { "$value": "380ms", "$type": "duration" }
    }
  }
}
